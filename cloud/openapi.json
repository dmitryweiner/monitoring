{
  "openapi": "3.1.0",
  "info": {
    "title": "Home monitoring API",
    "version": "1.0.0",
    "description": "HTTPS; Unix seconds UTC. observed_at — время измерения, received_at — приём. Фото и аудио 30 дней, измерения 90 дней. См. README.md."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Проверить Worker и D1",
        "security": [],
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "429": {
            "description": "Квота/частота запросов, Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "const": "60"
                },
                "description": "Задержка перед повтором в секундах"
              }
            }
          },
          "503": {
            "description": "Временная ошибка, повторить позже",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
