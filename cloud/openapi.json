            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Нет действующей авторизации",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Квота/частота запросов, Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "const": "60"
                },
                "description": "Задержка перед повтором в секундах"
              }
            }
          },
          "503": {
            "description": "Временная ошибка, повторить позже",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный JSON или заголовки фото",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Тело запроса превышает лимит",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin или CSRF не разрешён",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 256,
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "description": "Ответ session_key и expires_at, устанавливается Secure/HttpOnly/SameSite=Strict cookie."
      },
      "delete": {
        "summary": "Отозвать текущую сессию",
        "security": [
          {
            "session": []
          },
          {
            "cookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Сессия отозвана, cookie очищена."
          },
          "401": {
            "description": "Нет действующей авторизации",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Квота/частота запросов, Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "const": "60"
                },
                "description": "Задержка перед повтором в секундах"
              }
            }
          },
          "503": {
            "description": "Временная ошибка, повторить позже",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin или CSRF не разрешён",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Для cookie обязательны разрешённый Origin и X-CSRF-Token: 1.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ]
      }
    },
    "/v1/measurements/aggregate": {
      "get": {
        "summary": "Агрегация числовой метрики",
        "security": [
          {
            "session": []
          },
          {
            "cookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Успех",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aggregate"
                }
              }
            }
          },
          "401": {
            "description": "Нет действующей авторизации",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Квота/частота запросов, Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "const": "60"
                },
                "description": "Задержка перед повтором в секундах"
              }
            }
          },
          "503": {
            "description": "Временная ошибка, повторить позже",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Некорректные параметры или событие",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,64}$"
            }
          },
          {
            "name": "metric",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]{1,64}$"
            }
          },
          {
            "name": "bucket_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 600,
              "maximum": 86400,
              "default": 3600
            }
          }
        ],
        "description": "bucket_seconds: целое 600–86400, по умолчанию 3600, максимум 1000 интервалов. Ответ source,metric,bucket_seconds,items: bucket/count/mean/minimum/maximum. UTC, конец диапазона исключается."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "device": {
        "type": "http",
        "scheme": "bearer",
        "description": "Только загрузка."
      },
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "session_key из POST /v1/session."
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "monitor_session"
      }
    },
    "schemas": {
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "device_id",
          "event_id",
          "observed_at",
          "kind",
          "source",
          "status",
          "values",
          "clock_synchronized"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "device_id": {
            "type": "string"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "observed_at": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "measurement",
              "photo",
              "audio"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "values": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "pattern": "^[a-zA-Z0-9_]{1,64}$"
            }
          },
          "clock_synchronized": {
            "type": "boolean"
          }
        }
      },
      "StoredEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "device_id",
          "event_id",
          "observed_at",
          "kind",
          "source",
          "status",
          "values",
          "clock_synchronized",
          "received_at"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "device_id": {
            "type": "string"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "observed_at": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "measurement",
              "photo"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "values": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "pattern": "^[a-zA-Z0-9_]{1,64}$"
            }
          },
          "clock_synchronized": {
            "type": "boolean"
          },
          "received_at": {
            "type": "number"
          }
        }
      },
      "MeasurementEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Event"
          },
          {
            "properties": {
              "kind": {
                "const": "measurement"
              }
            }
          }
        ]
      },
      "PhotoEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Event"
          },
          {
            "properties": {
              "kind": {
                "const": "photo"
              },
              "status": {
                "const": "ok"
              }
            }
          }
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "PhotoAck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "status"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "stored",
              "duplicate",
              "expired",
              "invalid_time",
              "conflict"
            ]
          }
        }
      },
      "MeasurementAck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "status"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "enum": [
              "stored",
              "duplicate",
              "expired",
              "invalid_time",
              "conflict",
              "invalid"
            ]
          }
        }
      },
      "BatchAck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeasurementAck"
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StoredEvent"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Latest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "last_seen",
          "items"
        ],
        "properties": {
          "device_id": {
            "type": "string"
          },
          "last_seen": {
            "type": [
              "number",
              "null"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StoredEvent"
            }
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_key",
          "expires_at"
        ],
        "properties": {
          "session_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expires_at": {
            "type": "number"
          }
        }
      },
      "Aggregate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "metric",
          "bucket_seconds",
          "items"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "bucket_seconds": {
            "type": "integer",
            "minimum": 600,
            "maximum": 86400
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bucket",
                "count",
                "mean",
                "minimum",
                "maximum"
              ],
              "properties": {
                "bucket": {
                  "type": "number"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "mean": {
                  "type": "number"
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "AudioEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Event"
          },
          {
            "properties": {
              "kind": {
                "const": "audio"
              },
              "status": {
                "const": "ok"
              }
            }
          }
        ]
      }
    }
  }
}
