          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ],
        "description": "Упорядочено по (observed_at,event_id). Ответ items и next_cursor. limit 1–1000; повторять те же фильтры при продолжении."
      },
      "post": {
        "summary": "До 12 измерений (kind=measurement)",
        "security": [
          {
            "device": []
          }
        ],
        "responses": {
          "200": {
            "description": "Успех",
