device_id = "home"
server_url = "https://monitor.example.com"
token_file = "/etc/monitoring/device.token"
state_dir = "/var/lib/monitoring-agent"
interval_seconds = 600

[queue]
max_age = 86400
max_bytes = 536870912
reserve_bytes = 1073741824

[camera]
enabled = true
device = "/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._UGREEN_Camera_2K_SN0001-video-index0"
size = "1920x1080"
input_format = "mjpeg"
timeout_seconds = 30

# Raised attention: the camera takes a frame every interval_seconds, which must
# divide the top-level interval_seconds, and compares it with the one before.
# A frame that differs by more than change_threshold (a share of pixels,
# brightness aside) raises attention, and every frame is sent until calm_frames
# quiet ones in a row lower it. Otherwise a frame is sent only once the top-level
# interval has passed since the last photo. pixel_threshold is in standard
# deviations. With enabled = false the camera takes one photo per interval.
[attention]
enabled = true
interval_seconds = 60
change_threshold = 0.07
pixel_threshold = 0.5
calm_frames = 2

# While attention is raised the microphone records; each minute holding at least
# min_windows 100 ms windows above threshold_dbfs is sent as Ogg/Opus. The first
# camera's microphone hissed at about -42.5 dBFS in a quiet room; the UGREEN one is
# not measured yet. It is stereo only, so plughw converts it to mono. The board's
# own codec is hw:CARD=sndi2s4,DEV=0, but it read -80 dBFS: its analogue input
# looks unconnected.
[audio]
enabled = true
device = "plughw:CARD=U2K,DEV=0"
threshold_dbfs = -30.0
min_windows = 3
bitrate = "16k"

[[sources]]
name = "cpu"
[sources.fields.cpu_temperature_c]
path = "/sys/class/thermal/thermal_zone0/temp"
scale = 0.001

# DHT11 on header pin 22 (PD23); see docs/PINOUT.md. The agent needs access to
# /dev/gpiochip0 and LimitRTPRIO in its unit, both described there.
[[sources]]
name = "room"
type = "dht11"
chip = "/dev/gpiochip0"
line = 119
attempts = 8

# BMP280 on I2C bus TWI0, header pins 3 and 5, SDO to ground; see docs/PINOUT.md.
# Needs overlays=i2c0 in /boot/armbianEnv.txt and access to /dev/i2c-0.
[[sources]]
name = "barometer"
type = "bmp280"
bus = 0
address = 0x76
