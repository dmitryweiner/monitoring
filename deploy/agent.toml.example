device_id = "home"
server_url = "https://monitor.example.com"
token_file = "/etc/monitoring/device.token"
state_dir = "/var/lib/monitoring-agent"
interval_seconds = 600

[queue]
max_age = 86400
max_bytes = 536870912
reserve_bytes = 1073741824

[camera]
enabled = true
device = "/dev/v4l/by-id/usb-Web_Camera_Web_Camera_202512181-video-index0"
size = "1280x720"
input_format = "mjpeg"
timeout_seconds = 30

# Raised attention: a photo that differs from the previous one by more than
# change_threshold (a share of pixels, brightness aside) switches photos to every
# interval_seconds, which must divide the top-level interval_seconds; calm_frames
# quiet photos in a row switch back. pixel_threshold is in standard deviations.
[attention]
enabled = true
interval_seconds = 60
change_threshold = 0.06
pixel_threshold = 0.5
calm_frames = 2

# While attention is raised the microphone records; each minute holding at least
# min_windows 100 ms windows above threshold_dbfs is sent as Ogg/Opus. The camera
# microphone hisses at about -42.5 dBFS in a quiet room. The board's own codec is
# hw:CARD=sndi2s4,DEV=0, but it read -80 dBFS: its analogue input looks unconnected.
[audio]
enabled = true
device = "hw:CARD=Camera,DEV=0"
threshold_dbfs = -30.0
min_windows = 3
bitrate = "16k"

[[sources]]
name = "cpu"
[sources.fields.cpu_temperature_c]
path = "/sys/class/thermal/thermal_zone0/temp"
scale = 0.001

# DHT11 on header pin 22 (PD23); see docs/PINOUT.md. The agent needs access to
# /dev/gpiochip0 and LimitRTPRIO in its unit, both described there.
[[sources]]
name = "room"
type = "dht11"
chip = "/dev/gpiochip0"
line = 119
attempts = 8

# BMP280 on I2C bus TWI0, header pins 3 and 5, SDO to ground; see docs/PINOUT.md.
# Needs overlays=i2c0 in /boot/armbianEnv.txt and access to /dev/i2c-0.
[[sources]]
name = "barometer"
type = "bmp280"
bus = 0
address = 0x76
