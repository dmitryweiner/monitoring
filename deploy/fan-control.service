[Unit]
Description=Case fan switched by SoC temperature
Documentation=file:/usr/local/sbin/fan-control.sh
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/fan-control.sh
Restart=always
RestartSec=5
# Thresholds, in case they need changing without touching the script
# (millidegrees Celsius, seconds):
# Environment=FAN_TEMP_ON=55000
# Environment=FAN_TEMP_OFF=48000
# Environment=FAN_MIN_ON=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
MemoryMax=32M
TasksMax=16
TimeoutStopSec=10
LogRateLimitIntervalSec=60
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
