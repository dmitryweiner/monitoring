[Unit]
Description=Home monitoring collector and uploader
After=network.target

[Service]
Type=simple
User=monitoring
Group=monitoring
SupplementaryGroups=video
WorkingDirectory=/opt/monitoring
ExecStart=/usr/bin/python3 -m monitoring.agent
Restart=on-failure
RestartSec=10
StateDirectory=monitoring-agent
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=192M
TasksMax=64
TimeoutStopSec=45
LogRateLimitIntervalSec=60
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
